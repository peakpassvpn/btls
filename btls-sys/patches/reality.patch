diff --git a/ssl/handshake_client.cc b/ssl/handshake_client.cc
index f52bff3..3889a72 100644
--- a/ssl/handshake_client.cc
+++ b/ssl/handshake_client.cc
@@ -235,6 +235,62 @@ bool ssl_write_client_hello_without_extensions(const SSL_HANDSHAKE *hs,
   return true;
 }
 
+// finalize_client_hello runs the |SSL_set_client_hello_finalize_cb| callback
+// on the first ClientHello |msg|, and puts the session ID it returns in |msg|
+// and |hs|, so the ServerHello's echo of it matches.
+static bool finalize_client_hello(SSL_HANDSHAKE *hs,
+                                  ssl_client_hello_type_t type,
+                                  Span<uint8_t> msg) {
+  SSLImpl *const ssl = hs->ssl;
+  SSL_client_hello_finalize_cb_func cb = hs->config->client_hello_finalize_cb;
+  if (cb == nullptr || ssl->s3->used_hello_retry_request) {
+    return true;
+  }
+  // The session ID follows the four-byte header, the version and the random.
+  constexpr size_t kSessionIDOffset = 4 + 2 + SSL3_RANDOM_SIZE + 1;
+  // A PSK binder, already computed over the ClientHello, would no longer
+  // match the new session ID.
+  if (SSL_is_dtls(ssl) || SSL_is_quic(ssl) || ssl->session != nullptr ||
+      type != ssl_client_hello_unencrypted ||
+      hs->session_id.size() != SSL3_SESSION_ID_SIZE ||
+      msg.size() < kSessionIDOffset + SSL3_SESSION_ID_SIZE ||
+      msg[kSessionIDOffset - 1] != SSL3_SESSION_ID_SIZE) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_HANDSHAKE_FAILURE_ON_CLIENT_HELLO);
+    return false;
+  }
+
+  // A standalone X25519 share first, as a server that finds one uses it.
+  uint8_t x25519_private_key[32];
+  bool found = false;
+  for (uint16_t group : {SSL_GROUP_X25519, SSL_GROUP_X25519_MLKEM768}) {
+    for (const auto &key_share : hs->key_shares) {
+      if (!found && key_share->GroupID() == group &&
+          key_share->X25519PrivateKey(x25519_private_key)) {
+        found = true;
+      }
+    }
+  }
+  if (!found) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_MISSING_KEY_SHARE);
+    return false;
+  }
+
+  Span<uint8_t> session_id =
+      msg.subspan(kSessionIDOffset, SSL3_SESSION_ID_SIZE);
+  OPENSSL_memset(session_id.data(), 0, session_id.size());
+  uint8_t new_session_id[SSL3_SESSION_ID_SIZE];
+  int ok = cb(ssl, msg.data(), msg.size(), ssl->s3->client_random,
+              x25519_private_key, new_session_id);
+  OPENSSL_cleanse(x25519_private_key, sizeof(x25519_private_key));
+  if (!ok) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_HANDSHAKE_FAILURE_ON_CLIENT_HELLO);
+    return false;
+  }
+  OPENSSL_memcpy(session_id.data(), new_session_id, sizeof(new_session_id));
+  hs->session_id.CopyFrom(new_session_id);
+  return true;
+}
