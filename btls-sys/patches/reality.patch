+// SSL_client_hello_finalize_cb_func is called on a client for the first
+// ClientHello of a connection, after it is encoded and before it is added to
+// the transcript and sent. |hello| is the ClientHello message, with its
+// four-byte header and with its 32-byte legacy_session_id zeroed.
+// |x25519_private_key| is the private key of the X25519 key share: the
+// standalone X25519 share if one is offered, else the X25519 half of the
+// X25519MLKEM768 share. The callback writes the legacy_session_id to send to
+// |out_session_id| and returns one, or returns zero to fail the handshake.
+//
+// Protocols that authenticate the client in the session ID, such as REALITY,
+// use it.
+typedef int (*SSL_client_hello_finalize_cb_func)(
+    SSL *ssl, const uint8_t *hello, size_t hello_len,
+    const uint8_t client_random[32], const uint8_t x25519_private_key[32],
+    uint8_t out_session_id[32]);
+
+// SSL_set_client_hello_finalize_cb sets |cb| on |ssl|. With it set, the
+// handshake fails unless the ClientHello carries a 32-byte session ID (TLS 1.3
+// compatibility mode) and an X25519 or X25519MLKEM768 key share. It does not
+// apply to DTLS, QUIC, ECH or session resumption.
+OPENSSL_EXPORT void SSL_set_client_hello_finalize_cb(
+    SSL *ssl, SSL_client_hello_finalize_cb_func cb);
