+int SSL_set_ech_grease_shape(SSL *ssl, uint16_t aead_id, size_t payload_len) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config) {
+    return 0;
+  }
+  if (aead_id != 0 && aead_id != EVP_HPKE_AES_128_GCM &&
+      aead_id != EVP_HPKE_AES_256_GCM &&
+      aead_id != EVP_HPKE_CHACHA20_POLY1305) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_UNSUPPORTED_ECH_SERVER_CONFIG);
+    return 0;
+  }
+  ssl_impl->config->ech_grease_aead_id = aead_id;
+  ssl_impl->config->ech_grease_payload_len = payload_len;
+  return 1;
+}
