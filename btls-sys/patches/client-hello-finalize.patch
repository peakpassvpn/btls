 }
 
+void SSL_set_client_hello_finalize_cb(SSL *ssl,
+                                      SSL_client_hello_finalize_cb_func cb) {
+  if (!ssl->config) {
+    return;
+  }
+  ssl->config->client_hello_finalize_cb = cb;
+}
